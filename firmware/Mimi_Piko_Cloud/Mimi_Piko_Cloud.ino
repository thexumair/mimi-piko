/*
  ============================================================
   MIMI PIKO CLOUD  -  faces on the pot + data on Vercel cloud
  ============================================================
   Hardware: ESP32-S3 + 1.3" OLED (SH1106, I2C) + resistive soil sensor (LM393)

   WIRING  (same as the original, nothing to change)
     OLED  VCC -> 3V3     GND -> GND     SDA -> GPIO 41    SCL -> GPIO 42
     SOIL  VCC -> 3V3     GND -> GND     AO  -> GPIO 14    DO  -> not used

   WHY WIFI IS ONLY ON FOR A FEW SECONDS
     GPIO 14 is an ADC2 pin, and ADC2 can't be read while WiFi is on.
     So Mimi keeps WiFi OFF and reads the soil normally. Once a minute
     it pauses reading, turns WiFi on, uploads, and turns WiFi off again.

   WHAT IT DOES
     - Same faces as before: sad when dry, happy animation when wet
     - Detects waterings by itself (moisture jumps up)
     - Every minute turns WiFi on briefly and sends raw, moisture %, mood and new waterings to
       your Vercel cloud API. The cloud stores the history, draws the
       chart and sends a "Mimi is thirsty!" phone alert.
     - Uploading runs in the background, so the faces never freeze.
     - If WiFi or the internet is down, the faces still work.

   SET THESE 4 THINGS BELOW: WIFI_SSID, WIFI_PASS, CLOUD_URL, DEVICE_KEY
   Libraries: U8g2 (Library Manager). Everything else comes with
   the ESP32 Arduino core 3.x.
*/

#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>
#include <WiFi.h>
#include <WiFiClientSecure.h>
#include <HTTPClient.h>

// ================= EDIT THESE =================
const char* WIFI_SSID  = "YOUR_WIFI_NAME";
const char* WIFI_PASS  = "YOUR_WIFI_PASSWORD";
const char* CLOUD_URL  = "https://YOUR-PROJECT.vercel.app/api/reading";
const char* DEVICE_KEY = "CHANGE_ME_TO_A_SECRET";   // same as DEVICE_KEY on Vercel

// ================= PINS =================
#define PIN_SDA  41
#define PIN_SCL  42
#define SOIL_PIN 14

// ================= SOIL CALIBRATION =================
// Higher raw value = drier soil. Check the Serial Monitor and adjust.
#define SOIL_DRY_THRESHOLD 2500   // raw >= this means DRY (sad face)
#define SOIL_RAW_DRY       3500   // raw reading in fully dry soil   (= 0%)
#define SOIL_RAW_WET       1200   // raw reading right after watering (= 100%)

// ================= WATERING DETECTION =================
#define WATER_JUMP_PCT     15                       // moisture must rise this many %
#define WATER_COOLDOWN_MS  (30UL * 60UL * 1000UL)   // ignore repeats for 30 min
#define SLOT_EVERY_MS      30000                    // keep a sample every 30 s
#define SLOTS              8                        // 8 x 30 s = last 4 minutes

// ================= TIMING =================
#define SAMPLE_EVERY_MS    1000    // read soil every 1 s
#define UPLOAD_EVERY_MS    60000   // send to cloud every 60 s
#define WIFI_CONNECT_MS    12000   // give up a connect attempt after 12 s
#define FRAME_MS           40      // happy animation speed

U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE, PIN_SCL, PIN_SDA);

