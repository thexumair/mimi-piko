// ============================================================
//                         STATE
// ============================================================
// Shared between the main loop and the upload task
volatile int  soilRaw = 0;
volatile int  soilPct = 0;
volatile bool isDry   = false;
volatile int  pendingWaterings = 0;      // waterings not yet sent to the cloud
volatile bool uploadNow = false;         // send right away (mood change / watering)
volatile int  lastHttpCode = 0;          // last cloud response (200 = OK)
volatile bool radioBusy = false;         // WiFi is on: don't touch ADC2
volatile bool adcBusy   = false;         // main loop is reading the sensor
portMUX_TYPE  mux = portMUX_INITIALIZER_UNLOCKED;

int  lastSoilState = -1;
int  slotPct[SLOTS];
int  slotCount = 0, slotIdx = 0;
unsigned long lastWaterMs = 0;
bool haveWaterMs = false;

int  happyFrame = 0;
unsigned long lastSampleMs = 0, lastSlotMs = 0, lastFrameMs = 0;

// ============================================================
//                         SOIL
// ============================================================
void readSoil() {
  if (radioBusy) return;                 // WiFi is on for an upload: keep the last reading
  adcBusy = true;
  if (radioBusy) { adcBusy = false; return; }
  long sum = 0;
  for (int i = 0; i < 10; i++) { sum += analogRead(SOIL_PIN); delay(2); }
  adcBusy = false;
  int raw = sum / 10;
  int pct = constrain((int)map(raw, SOIL_RAW_DRY, SOIL_RAW_WET, 0, 100), 0, 100);
  bool dry = (raw >= SOIL_DRY_THRESHOLD);

  soilRaw = raw; soilPct = pct; isDry = dry;

  if (dry && lastSoilState != 1)  { Serial.println("Mimi is SAD - soil is DRY");  lastSoilState = 1; uploadNow = true; }
  if (!dry && lastSoilState != 0) { Serial.println("Mimi is HAPPY - soil is WET"); lastSoilState = 0; happyFrame = 0; uploadNow = true; }

  Serial.printf("Soil raw: %d  moisture: %d%%  last cloud: %d\n", raw, pct, lastHttpCode);
}

void resetSlots() {
  for (int i = 0; i < SLOTS; i++) slotPct[i] = soilPct;
  slotCount = SLOTS;
}

void checkWatering() {
  unsigned long now = millis();
  if (slotCount == 0 || now - lastSlotMs >= SLOT_EVERY_MS) {   // one sample every 30 s
    lastSlotMs = now;
    slotPct[slotIdx] = soilPct;
    slotIdx = (slotIdx + 1) % SLOTS;
    if (slotCount < SLOTS) slotCount++;
  }
  int minPct = 100;
  for (int i = 0; i < slotCount; i++) minPct = min(minPct, slotPct[i]);

  bool cooledDown = !haveWaterMs || (now - lastWaterMs > WATER_COOLDOWN_MS);
  if (soilPct - minPct >= WATER_JUMP_PCT && cooledDown) {
    portENTER_CRITICAL(&mux); pendingWaterings++; portEXIT_CRITICAL(&mux);
    lastWaterMs = now; haveWaterMs = true;
    resetSlots();
    uploadNow = true;
    Serial.println("WATERING detected, will send to cloud");
  }
}

// ============================================================
//                         CLOUD UPLOAD (background task)
// ============================================================
bool sendReading() {
  int waterings;
  portENTER_CRITICAL(&mux); waterings = pendingWaterings; portEXIT_CRITICAL(&mux);

  String body = "{\"raw\":" + String(soilRaw) +
                ",\"pct\":" + String(soilPct) +
                ",\"dry\":" + String(isDry ? "true" : "false") +
                ",\"waterings\":" + String(waterings) + "}";

  WiFiClientSecure client;
  client.setInsecure();                 // skip certificate check (fine for a class project)
  HTTPClient http;
  http.setTimeout(8000);
  if (!http.begin(client, CLOUD_URL)) { lastHttpCode = -1; return false; }
  http.addHeader("Content-Type", "application/json");
  http.addHeader("x-device-key", DEVICE_KEY);
  int code = http.POST(body);
  http.end();
  lastHttpCode = code;

  if (code == 200) {                    // only clear waterings once the cloud has them
    portENTER_CRITICAL(&mux); pendingWaterings -= waterings; portEXIT_CRITICAL(&mux);
    return true;
  }
  Serial.printf("Cloud upload failed, HTTP %d\n", code);
  return false;
}

// Turn WiFi on, send one reading, turn WiFi off again
void uploadOnce() {
  radioBusy = true;
  while (adcBusy) vTaskDelay(pdMS_TO_TICKS(5));      // let a reading finish first

  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long start = millis();
  while (WiFi.status() != WL_CONNECTED && millis() - start < WIFI_CONNECT_MS) vTaskDelay(pdMS_TO_TICKS(200));

  if (WiFi.status() == WL_CONNECTED) {
    bool ok = sendReading();
    Serial.printf("Upload %s (HTTP %d)\n", ok ? "OK" : "failed", lastHttpCode);
  } else {
    lastHttpCode = -2;
    Serial.println("WiFi not found, will try again next minute");
  }

  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
  vTaskDelay(pdMS_TO_TICKS(200));                   // let ADC2 settle
  radioBusy = false;
}

void uploadTask(void*) {
  unsigned long lastUpload = millis();              // first upload already done in setup
  bool first = false;
  for (;;) {
    unsigned long now = millis();
    if (first || uploadNow || now - lastUpload >= UPLOAD_EVERY_MS) {
      uploadNow = false;
      first = false;
      uploadOnce();
      lastUpload = millis();
    }
    vTaskDelay(pdMS_TO_TICKS(500));
  }
}

// ============================================================
//                         DRAWING
// ============================================================
// small cloud icon top-right: filled = last upload OK, outline = not sent
void drawCloudIcon() {
  int x = 110, y = 1;
  u8g2.setDrawColor(0); u8g2.drawBox(x - 2, 0, 20, 11); u8g2.setDrawColor(1);
  bool ok = (lastHttpCode == 200);
  if (ok) {
    u8g2.drawDisc(x + 5, y + 5, 3); u8g2.drawDisc(x + 10, y + 4, 4); u8g2.drawBox(x + 3, y + 5, 11, 4);
  } else {
    u8g2.drawCircle(x + 5, y + 5, 3); u8g2.drawCircle(x + 10, y + 4, 4); u8g2.drawFrame(x + 3, y + 5, 11, 4);
  }
}

void drawSadFace() {
  u8g2.drawDisc(40, 27, 7);  u8g2.drawDisc(88, 27, 7);          // eyes
  u8g2.setDrawColor(0);
  u8g2.drawDisc(38, 25, 2);  u8g2.drawDisc(86, 25, 2);          // highlights
  u8g2.setDrawColor(1);
  u8g2.drawLine(30, 17, 46, 21); u8g2.drawLine(82, 21, 98, 17); // brows
  u8g2.drawLine(50, 50, 55, 46); u8g2.drawLine(55, 46, 60, 44); // frown
  u8g2.drawLine(60, 44, 64, 43); u8g2.drawLine(64, 43, 68, 44);
  u8g2.drawLine(68, 44, 73, 46); u8g2.drawLine(73, 46, 78, 50);
  u8g2.drawDisc(40, 38, 2);  u8g2.drawDisc(88, 38, 2);          // tears
}

void drawFace() {
  u8g2.clearBuffer();
  if (isDry) drawSadFace();
  else {
    happyFrame = (happyFrame + 1) % HAPPY_FRAME_COUNT;
    u8g2.drawXBMP(0, 0, 128, 64, happyFrames[happyFrame]);
  }
  drawCloudIcon();
  u8g2.sendBuffer();
}

void drawMessage(const char* l1, const char* l2, const char* l3) {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 14, l1);
  u8g2.drawStr(0, 34, l2);
  u8g2.drawStr(0, 54, l3);
  u8g2.sendBuffer();
}

// ============================================================
//                         SETUP / LOOP
// ============================================================
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(SOIL_PIN, INPUT);
  Wire.begin(PIN_SDA, PIN_SCL);
  u8g2.begin();

  Serial.println("\n===== MIMI PIKO CLOUD STARTED =====");
  Serial.println("Soil sensor: AO -> GPIO 14 (WiFi only on during uploads)");

  WiFi.persistent(false);
  WiFi.mode(WIFI_OFF);                              // keep ADC2 free
  readSoil();                                       // first reading with WiFi off
  resetSlots();

  // ---- first WiFi connection, shown on the screen ----
  radioBusy = true;
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  unsigned long start = millis();
  int dots = 0;
  while (WiFi.status() != WL_CONNECTED && millis() - start < WIFI_CONNECT_MS) {
    char line[24] = "Connecting WiFi";
    for (int i = 0; i < dots; i++) strcat(line, ".");
    drawMessage("Mimi Piko", line, WIFI_SSID);
    dots = (dots + 1) % 4;
    delay(400);
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.print("WiFi connected, IP "); Serial.println(WiFi.localIP());
    drawMessage("Mimi Piko", "WiFi connected!", "Sending to cloud...");
    bool ok = sendReading();
    Serial.printf("First upload %s (HTTP %d)\n", ok ? "OK" : "failed", lastHttpCode);
    drawMessage("Mimi Piko", ok ? "Cloud: connected" : "Cloud: not reached", ok ? "mimi-cloud.vercel.app" : "Will retry");
  } else {
    lastHttpCode = -2;
    Serial.println("WiFi not found, faces still work. Retrying every minute.");
    drawMessage("Mimi Piko", "No WiFi yet", "Faces still work");
  }
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);                              // back to WiFi off for ADC2
  delay(1800);
  radioBusy = false;

  // background upload on core 0, faces on core 1
  xTaskCreatePinnedToCore(uploadTask, "upload", 8192, nullptr, 1, nullptr, 0);
}

void loop() {
  unsigned long now = millis();

  if (now - lastSampleMs >= SAMPLE_EVERY_MS) {
    lastSampleMs = now;
    readSoil();
    checkWatering();
  }

  if (now - lastFrameMs >= FRAME_MS) {
    lastFrameMs = now;
    drawFace();
  }
}
