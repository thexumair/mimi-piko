// top-right corner: signal bars when on home WiFi, "AP" when hotspot only
void drawWifiIcon(int x, int y) {
  u8g2.setDrawColor(0); u8g2.drawBox(x - 1, y, 16, 10); u8g2.setDrawColor(1);
  int bars = wifiBars();
  if (bars < 0) {
    u8g2.setFont(u8g2_font_5x7_tf);
    u8g2.drawStr(x + 2, y + 8, "AP");
    return;
  }
  for (int i = 0; i < 4; i++) {
    int h = 2 + i * 2, bx = x + i * 4;
    if (i < bars) u8g2.drawBox(bx, y + 9 - h, 3, h);
    else          u8g2.drawPixel(bx + 1, y + 8);
  }
}

void drawSadFace() {
  u8g2.drawDisc(40, 27, 7);  u8g2.drawDisc(88, 27, 7);          // eyes
  u8g2.setDrawColor(0);
  u8g2.drawDisc(38, 25, 2);  u8g2.drawDisc(86, 25, 2);          // highlights
  u8g2.setDrawColor(1);
  u8g2.drawLine(30, 17, 46, 21); u8g2.drawLine(82, 21, 98, 17); // brows
  u8g2.drawLine(50, 50, 55, 46); u8g2.drawLine(55, 46, 60, 44); // frown
  u8g2.drawLine(60, 44, 64, 43); u8g2.drawLine(64, 43, 68, 44);
  u8g2.drawLine(68, 44, 73, 46); u8g2.drawLine(73, 46, 78, 50);
  u8g2.drawDisc(40, 38, 2);  u8g2.drawDisc(88, 38, 2);          // tears
}

void drawFaceScreen() {
  u8g2.clearBuffer();
  if (isDry) drawSadFace();
  else {
    happyFrame = (happyFrame + 1) % HAPPY_FRAME_COUNT;
    u8g2.drawXBMP(0, 0, 128, 64, happyFrames[happyFrame]);
  }
  drawWifiIcon(112, 0);
  u8g2.sendBuffer();
}

void drawInfoScreen() {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_6x10_tf);
  u8g2.drawStr(0, 9, "Mimi Piko");
  drawWifiIcon(112, 0);
  u8g2.setFont(u8g2_font_6x10_tf);

  String s = "Soil: " + String(soilPct) + "%  " + (isDry ? "DRY" : "WET");
  u8g2.drawStr(0, 21, s.c_str());
  u8g2.drawFrame(0, 24, 128, 7);
  u8g2.drawBox(1, 25, (126 * soilPct) / 100, 5);

  s = "Watered: " + agoText(lastWateredAgo());
  u8g2.drawStr(0, 42, s.c_str());
  s = "Times watered: " + String(waterCount);
  u8g2.drawStr(0, 52, s.c_str());

  if (staConnected()) s = "Home: " + WiFi.localIP().toString();
  else                s = "Portal: 192.168.4.1";
  u8g2.drawStr(0, 63, s.c_str());
  u8g2.sendBuffer();
}

void drawThanksScreen() {
  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_helvB12_tf);
  u8g2.drawStr((128 - u8g2.getStrWidth("Yay, water!")) / 2, 28, "Yay, water!");
