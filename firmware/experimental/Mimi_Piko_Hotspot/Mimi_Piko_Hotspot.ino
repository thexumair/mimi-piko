/*
  ============================================================
   MIMI PIKO v3  -  own WiFi hotspot + portal + watering log
  ============================================================
   Hardware: ESP32-S3 + 1.3" OLED (SH1106, I2C) + resistive soil sensor (LM393)

   WIRING
     OLED  VCC -> 3V3     GND -> GND     SDA -> GPIO 41    SCL -> GPIO 42
     SOIL  VCC -> 3V3     GND -> GND     AO  -> GPIO 4     DO  -> not used
     (AO is on GPIO 4 because GPIO 14 is an ADC2 pin, which fails while WiFi runs)

   HOW IT WORKS
     1. Mimi always makes its OWN WiFi hotspot:  "MimiPiko"  (password: mimipiko)
     2. Join it from your phone. The portal opens by itself, or go to
        http://192.168.4.1
     3. The portal shows moisture, mood, the watering log and a
        "Download log (CSV)" button. NO internet or home WiFi needed.
     4. Optional: in the portal, pick your home WiFi and type its password.
        Mimi then stays on your home WiFi too, so any phone/laptop on that
        network can open http://mimipiko.local anytime ("real time" mode).
        The hotspot keeps running either way.

     Clock: with no internet, Mimi takes the time from your phone when you
     open the portal, so watering times are correct even fully offline.

   Libraries: U8g2 (Library Manager). Everything else comes with the
   ESP32 Arduino core 3.x.
*/

#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>
#include <WiFi.h>
#include <WebServer.h>
#include <DNSServer.h>
#include <ESPmDNS.h>
#include <Preferences.h>
#include <time.h>
#include <sys/time.h>

// ================= HOTSPOT (edit if you like) =================
const char* AP_NAME  = "MimiPiko";
const char* AP_PASS  = "mimipiko";     // min 8 chars. Use "" for an open hotspot
const char* HOSTNAME = "mimipiko";     // http://mimipiko.local on home WiFi

// ================= PINS =================
#define PIN_SDA  41
#define PIN_SCL  42
#define SOIL_PIN 4

// ================= SOIL CALIBRATION =================
// Higher raw value = drier soil. Check the Serial Monitor and adjust.
#define SOIL_DRY_THRESHOLD 2500   // raw >= this means DRY (sad face)
#define SOIL_RAW_DRY       3500   // raw reading in fully dry soil   (= 0%)
#define SOIL_RAW_WET       1200   // raw reading right after watering (= 100%)

// ================= WATERING DETECTION =================
#define WATER_JUMP_PCT     15                       // moisture must rise this many %
#define WATER_COOLDOWN_MS  (30UL * 60UL * 1000UL)   // ignore repeats for 30 min
#define SAMPLE_EVERY_MS    1000                     // read soil every 1 s
#define SLOT_EVERY_MS      30000                    // keep a sample every 30 s
#define SLOTS              8                        // 8 x 30 s = last 4 minutes
#define MAX_LOG            20                       // remember last 20 waterings

// ================= HOME WIFI RETRY =================
#define STA_RETRY_MS       60000   // retry home WiFi every 60 s if it drops
#define STA_FAIL_MS        20000   // give up a single attempt after 20 s

// ================= SCREENS =================
#define FACE_SCREEN_MS   12000   // show face for 12 s
#define INFO_SCREEN_MS    5000   // then info screen for 5 s
#define THANKS_SCREEN_MS  3000   // "thank you" after watering
#define FRAME_MS            40   // happy animation speed

U8G2_SH1106_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, U8X8_PIN_NONE, PIN_SCL, PIN_SDA);

