// ============================================================
//                         HOME WIFI (optional)
// ============================================================
void startSta() {
  if (staSsid.length() == 0) return;
  WiFi.disconnect(false, false);
  WiFi.begin(staSsid.c_str(), staPass.c_str());
  staTrying = true; staFailed = false; staAttemptMs = millis();
  Serial.printf("Joining home WiFi \"%s\"...\n", staSsid.c_str());
}

void handleSta() {
  unsigned long now = millis();
  if (staConnected()) {
    staTrying = false; staFailed = false;
    if (!netStarted) {                       // first time online: clock + mDNS
      netStarted = true;
      configTzTime("PKT-5", "pool.ntp.org", "time.google.com");
      if (MDNS.begin(HOSTNAME)) MDNS.addService("http", "tcp", 80);
      Serial.print("Home WiFi connected: http://");
      Serial.print(WiFi.localIP()); Serial.println("  or  http://mimipiko.local");
    }
    return;
  }
  if (staSsid.length() == 0) return;
  if (staTrying && now - staAttemptMs > STA_FAIL_MS) {   // attempt timed out
    staTrying = false; staFailed = true;
    WiFi.disconnect(false, false);           // stop retrying for now, keeps hotspot stable
    Serial.println("Home WiFi not reachable. Hotspot still running.");
  }
  if (!staTrying && now - staAttemptMs > STA_RETRY_MS) startSta();
}

String staState() {
  if (staSsid.length() == 0) return "none";
  if (staConnected())        return "connected";
  if (staTrying)             return "connecting";
  return staFailed ? "failed" : "waiting";
}

