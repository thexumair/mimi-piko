  j += ",\"dry\":" + String(isDry ? "true" : "false");
  j += ",\"count\":" + String(waterCount);
  j += ",\"lastAgo\":" + String(lastWateredAgo());
  j += ",\"timeOk\":" + String(timeValid() ? "true" : "false");
  j += ",\"ap\":\"" + jsonEsc(AP_NAME) + "\"";
  j += ",\"sta\":\"" + staState() + "\"";
  j += ",\"ssid\":\"" + jsonEsc(staSsid) + "\"";
  j += ",\"ip\":\"" + (staConnected() ? WiFi.localIP().toString() : String("")) + "\"";
  j += ",\"rssi\":" + String(staConnected() ? WiFi.RSSI() : 0);
  j += ",\"history\":[";
  int n = min((int)waterCount, MAX_LOG);
  for (int i = 0; i < n; i++) {                       // newest first
    int idx = (logHead + MAX_LOG - 1 - i) % MAX_LOG;
    if (i) j += ",";
    j += String((long)waterLog[idx]);
  }
  j += "]}";
  return j;
}

String logCsv() {
  String c = "number,date_time,epoch\n";
  int n = min((int)waterCount, MAX_LOG);
  for (int i = n - 1; i >= 0; i--) {                  // oldest first
    int idx = (logHead + MAX_LOG - 1 - i) % MAX_LOG;
    int num = waterCount - i;
    String when = "unknown";
    if (waterLog[idx] > 0) {
      time_t t = (time_t)waterLog[idx];
      struct tm tmv; localtime_r(&t, &tmv);
      char buf[24]; strftime(buf, sizeof(buf), "%Y-%m-%d %H:%M:%S", &tmv);
      when = buf;
    }
    c += String(num) + "," + when + "," + String((long)waterLog[idx]) + "\n";
  }
  return c;
}

void sendStatus() { server.send(200, "application/json", statusJson()); }

void redirectToPortal() {
  // phones on Mimi's hotspot -> 192.168.4.1, devices on home WiFi -> Mimi's home IP
  bool viaHotspot = server.client().localIP() == WiFi.softAPIP();
  String home = "http://" + (viaHotspot ? WiFi.softAPIP().toString() : WiFi.localIP().toString()) + "/";
  server.sendHeader("Location", home, true);
  server.send(302, "text/plain", "");
}

void setupWeb() {
  server.on("/", []() { server.send_P(200, "text/html", PAGE); });
  server.on("/api/status", sendStatus);

  server.on("/api/water", HTTP_POST, []() { recordWatering(true); sendStatus(); });

  server.on("/api/reset", HTTP_POST, []() {
    waterCount = 0; logHead = 0; haveWaterMs = false;
    memset(waterLog, 0, sizeof(waterLog));
    saveLog();
    sendStatus();
  });

  server.on("/log.csv", []() {
    server.sendHeader("Content-Disposition", "attachment; filename=mimi_watering_log.csv");
    server.send(200, "text/csv", logCsv());
  });

  // phone sends its clock, so times work with no internet
  server.on("/api/time", HTTP_POST, []() {
    long t = server.arg("t").toInt();
    if (t > 1700000000 && !timeValid()) {
      struct timeval tv = { (time_t)t, 0 };
      settimeofday(&tv, nullptr);
      Serial.println("Clock set from phone");
    }
    sendStatus();
  });

  server.on("/api/scan", []() {
    int n = WiFi.scanComplete();
    if (n == WIFI_SCAN_FAILED) { WiFi.scanNetworks(true); n = WIFI_SCAN_RUNNING; }
    if (n == WIFI_SCAN_RUNNING) { server.send(200, "application/json", "{\"scanning\":true}"); return; }
    String j = "{\"scanning\":false,\"nets\":[";
    int added = 0;
    for (int i = 0; i < n && added < 20; i++) {
      String s = WiFi.SSID(i);
      if (s.length() == 0) continue;
      if (added++) j += ",";
      j += "{\"ssid\":\"" + jsonEsc(s) + "\",\"rssi\":" + String(WiFi.RSSI(i)) + "}";
    }
    j += "]}";
    WiFi.scanDelete();
    server.send(200, "application/json", j);
  });

  server.on("/api/connect", HTTP_POST, []() {
    staSsid = server.arg("ssid");
    staPass = server.arg("pass");
    prefs.putString("ssid", staSsid);
    prefs.putString("pass", staPass);
    startSta();
    sendStatus();
  });

  server.on("/api/forget", HTTP_POST, []() {
    staSsid = ""; staPass = "";
    prefs.remove("ssid"); prefs.remove("pass");
    WiFi.disconnect(false, true);
    staTrying = false; staFailed = false;
    sendStatus();
  });

  // captive portal: phone "check internet" URLs and anything else -> portal
  server.onNotFound(redirectToPortal);
  server.begin();
}

// ============================================================
//                         SETUP / LOOP
// ============================================================
void setup() {
  Serial.begin(115200);
  delay(500);

  pinMode(SOIL_PIN, INPUT);
  Wire.begin(PIN_SDA, PIN_SCL);
  u8g2.begin();

  setenv("TZ", "PKT-5", 1); tzset();                  // Pakistan time for the CSV

  prefs.begin("mimipiko", false);
  loadSaved();
  Serial.println("\n===== MIMI PIKO v3 STARTED =====");
  Serial.printf("Saved waterings: %lu\n", (unsigned long)waterCount);

  // ---- own hotspot (always on) + optional home WiFi ----
  WiFi.persistent(false);
  WiFi.mode(WIFI_AP_STA);
  WiFi.setHostname(HOSTNAME);
  WiFi.setAutoReconnect(false);                        // we retry ourselves (keeps hotspot stable)
  WiFi.softAPConfig(IPAddress(192, 168, 4, 1), IPAddress(192, 168, 4, 1), IPAddress(255, 255, 255, 0));
  if (strlen(AP_PASS) >= 8) WiFi.softAP(AP_NAME, AP_PASS);
  else                      WiFi.softAP(AP_NAME);
  dns.start(53, "*", WiFi.softAPIP());                 // captive portal DNS

  Serial.printf("Hotspot \"%s\" ready -> http://192.168.4.1\n", AP_NAME);
  String l2 = String("WiFi: ") + AP_NAME;
  String l3 = String("Pass: ") + (strlen(AP_PASS) >= 8 ? AP_PASS : "(open)");
  drawMessage("Join my hotspot!", l2.c_str(), l3.c_str(), "Go to 192.168.4.1");
  delay(3500);

  setupWeb();
  startSta();                                          // only if home WiFi was saved

  readSoil();
  resetSlots();
  screenSince = millis();
}

void loop() {
  unsigned long now = millis();

  dns.processNextRequest();
  server.handleClient();
  handleSta();

  if (now - lastSampleMs >= SAMPLE_EVERY_MS) {
    lastSampleMs = now;
    readSoil();
    checkWatering();
  }

  unsigned long onFor = now - screenSince;
  if      (screen == FACE   && onFor > FACE_SCREEN_MS)   { screen = INFO; screenSince = now; }
  else if (screen == INFO   && onFor > INFO_SCREEN_MS)   { screen = FACE; screenSince = now; }
  else if (screen == THANKS && onFor > THANKS_SCREEN_MS) { screen = FACE; screenSince = now; }

  if (now - lastFrameMs >= FRAME_MS) {
    lastFrameMs = now;
    if (screen == FACE)      drawFaceScreen();
    else if (screen == INFO) drawInfoScreen();
    else                     drawThanksScreen();
  }
}
