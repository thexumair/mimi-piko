// ============================================================
//                         HELPERS
// ============================================================
bool timeValid()   { return time(nullptr) > 1700000000; }
bool staConnected(){ return WiFi.status() == WL_CONNECTED; }

int wifiBars() {
  if (!staConnected()) return -1;
  long r = WiFi.RSSI();
  if (r > -55) return 4;
  if (r > -65) return 3;
  if (r > -75) return 2;
  if (r > -85) return 1;
  return 0;
}

long lastWateredAgo() {                  // seconds, -1 if never/unknown
  if (waterCount == 0) return -1;
  int64_t last = waterLog[(logHead + MAX_LOG - 1) % MAX_LOG];
  if (last > 0 && timeValid()) return (long)(time(nullptr) - last);
  if (haveWaterMs) return (millis() - lastWaterMs) / 1000;
  return -1;
}

String agoText(long s) {
  if (s < 0)     return "never";
  if (s < 60)    return "just now";
  if (s < 3600)  return String(s / 60) + "m ago";
  if (s < 86400) return String(s / 3600) + "h " + String((s % 3600) / 60) + "m ago";
  return String(s / 86400) + "d " + String((s % 86400) / 3600) + "h ago";
}

String jsonEsc(const String& in) {
  String o;
  for (char c : in) {
    if (c == '"' || c == '\\') { o += '\\'; o += c; }
    else if ((uint8_t)c < 0x20) o += ' ';
    else o += c;
  }
  return o;
}

// ---------- saved data ----------
void saveLog() {
  prefs.putUInt("count", waterCount);
  prefs.putUChar("head", logHead);
  prefs.putBytes("log", waterLog, sizeof(waterLog));
}

void loadSaved() {
  memset(waterLog, 0, sizeof(waterLog));
  waterCount = prefs.getUInt("count", 0);
  logHead    = prefs.getUChar("head", 0) % MAX_LOG;
  if (prefs.getBytesLength("log") == sizeof(waterLog)) prefs.getBytes("log", waterLog, sizeof(waterLog));
  staSsid = prefs.getString("ssid", "");
  staPass = prefs.getString("pass", "");
}

void resetSlots() {
  for (int i = 0; i < SLOTS; i++) slotPct[i] = soilPct;
  slotCount = SLOTS;
}

void recordWatering(bool manual) {
  waterCount++;
  waterLog[logHead] = timeValid() ? (int64_t)time(nullptr) : 0;
  logHead = (logHead + 1) % MAX_LOG;
  lastWaterMs = millis();
  haveWaterMs = true;
  saveLog();
  resetSlots();                       // don't count the same watering twice
  screen = THANKS; screenSince = millis();
  Serial.printf("WATERING #%lu logged (%s)\n", (unsigned long)waterCount, manual ? "manual" : "auto");
}

// ============================================================
//                         SOIL
// ============================================================
void readSoil() {
  long sum = 0;
  for (int i = 0; i < 10; i++) { sum += analogRead(SOIL_PIN); delay(2); }
  soilRaw = sum / 10;
  soilPct = constrain((int)map(soilRaw, SOIL_RAW_DRY, SOIL_RAW_WET, 0, 100), 0, 100);
  isDry   = (soilRaw >= SOIL_DRY_THRESHOLD);

  if (isDry && lastSoilState != 1)  { Serial.println("Mimi is SAD - soil is DRY");  lastSoilState = 1; }
  if (!isDry && lastSoilState != 0) { Serial.println("Mimi is HAPPY - soil is WET"); lastSoilState = 0; happyFrame = 0; }

  Serial.printf("Soil raw: %d  moisture: %d%%\n", soilRaw, soilPct);
}

void checkWatering() {
  unsigned long now = millis();
  if (slotCount == 0 || now - lastSlotMs >= SLOT_EVERY_MS) {   // one sample every 30 s
    lastSlotMs = now;
    slotPct[slotIdx] = soilPct;
    slotIdx = (slotIdx + 1) % SLOTS;
    if (slotCount < SLOTS) slotCount++;
  }
  int minPct = 100;
  for (int i = 0; i < slotCount; i++) minPct = min(minPct, slotPct[i]);

  bool cooledDown = !haveWaterMs || (now - lastWaterMs > WATER_COOLDOWN_MS);
  if (soilPct - minPct >= WATER_JUMP_PCT && cooledDown) recordWatering(false);
}

